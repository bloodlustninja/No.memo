<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nos_black"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/font_ndot"
                android:letterSpacing="0.08"
                android:text="@string/app_header"
                android:textAllCaps="true"
                android:textColor="@color/nos_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_search"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="@color/nos_text_primary" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/nos_text_primary" />
        </LinearLayout>

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/nos_card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nos_card_stroke"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:autofillHints=""
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/nos_text_primary"
                android:textColorHint="@color/nos_text_secondary"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Filter Pills Bar -->
        <HorizontalScrollView
            android:id="@+id/scrollViewFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerFilterPills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pillAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_ndot"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_all"
                    android:textColor="@color/nos_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pillNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.4"
                    android:background="@drawable/bg_pill_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_ndot"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_notes"
                    android:textColor="@color/nos_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pillMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.4"
                    android:background="@drawable/bg_pill_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_ndot"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_media"
                    android:textColor="@color/nos_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pillChecklists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.4"
                    android:background="@drawable/bg_pill_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_ndot"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_checklists"
                    android:textColor="@color/nos_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Main Notes RecyclerView & Dot-Matrix Background -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeDotMatrixBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="90dp"
                tools:layoutManager="androidx.recyclerview.widget.StaggeredGridLayoutManager"
                tools:listitem="@layout/item_note_bento"
                tools:spanCount="2" />

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/empty_notes_title"
                    android:src="@drawable/ic_empty_notes" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/font_ndot"
                    android:letterSpacing="0.15"
                    android:text="@string/empty_notes_title"
                    android:textColor="@color/nos_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="@string/empty_notes_subtitle"
                    android:textColor="@color/nos_card_stroke_active"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Full-Screen Compose Container for Live Voice Transcription & Blur Backdrop -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeVoiceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Signature Floating Capsule Dock -->
    <LinearLayout
        android:id="@+id/floatingDock"
        android:layout_width="260dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_dock"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnDockText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_dock_text"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dock_text"
            app:tint="@color/nos_text_primary" />

        <ImageButton
            android:id="@+id/btnDockChecklist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_dock_checklist"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dock_checklist"
            app:tint="@color/nos_text_primary" />

        <ImageButton
            android:id="@+id/btnDockImage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_dock_image"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dock_image"
            app:tint="@color/nos_text_primary" />

        <ImageButton
            android:id="@+id/btnDockVoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_dock_voice"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dock_voice"
            app:tint="@color/nos_text_primary" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>