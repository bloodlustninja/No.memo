<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle frosted light outer glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Translucent glassmorphic body with frosted white gradient -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F2FFFFFF"
                android:centerColor="#E6F4F4F8"
                android:endColor="#D9EAEAEE"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#33000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>