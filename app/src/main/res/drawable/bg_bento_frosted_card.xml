<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle frosted light outer shadow/glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Translucent glassmorphic body with frosted white gradient & top light highlight -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F2FFFFFF"
                android:centerColor="#E6F2F2F6"
                android:endColor="#D9E4E4EA"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#40000000" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>